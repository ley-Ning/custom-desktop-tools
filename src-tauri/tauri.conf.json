{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "my-utools",
    "version": "0.1.0",
    "identifier": "com.lewen.my-utools",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "macOSPrivateApi": true,
        "windows": [
            {
                "title": "My uTools",
                "width": 900,
                "height": 600,
                "resizable": false,
                "center": true,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "visible": false,
                "dragDropEnabled": false,
                "skipTaskbar": true
            }
        ],
        "security": {
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png"
        ],
        "macOS": {
            "minimumSystemVersion": "10.13"
        }
    },
    "plugins": {
        "shell": {
            "open": true
        },
        "globalShortcut": {}
    }
}